{
  "expo": {
    "name": "Rohner Dispo",
    "slug": "rohner-dispo",
    "version": "0.8.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.rohner-transport.dispo"
    },
    "android": {
      "package": "ch.rohner_transport.dispo"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Die Rohner Kommunikationsapp benötigt Zugriff auf Fotos für Schadenmeldungen.",
          "cameraPermission": "Die Rohner Kommunikationsapp benötigt die Kamera, um Schäden und Defekte zu fotografieren.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/rohner-dispo"
    }
  }
}
